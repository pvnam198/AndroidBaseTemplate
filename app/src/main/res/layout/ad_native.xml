<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ native trong feed trang chủ (BaseAdRecyclerAdapter bind qua AdNativeBinding): template Figma Big1
     cộng thêm dòng ad_advertiser mà feed bind. -->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ad_card"
    android:padding="@dimen/ad_card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.namstd.androidskillhub.core.ads.template.AdMediaFrame
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:adCornerRadius="@dimen/ad_media_radius"
            app:adRatio="16:9">

            <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.namstd.androidskillhub.core.ads.template.AdMediaFrame>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ad_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ad_icon"
                style="@style/Widget.Ad.Icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ad_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Viết trực tiếp, không dùng <include>: AdNativeBinding cần ad_headline là binding field trực tiếp. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView style="@style/Widget.Ad.Badge" />

                    <TextView
                        android:id="@+id/ad_headline"
                        style="@style/Widget.Ad.Title" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ad_advertiser"
                    style="@style/Widget.Ad.Body"
                    android:layout_marginTop="2dp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/ad_body"
                    style="@style/Widget.Ad.Body"
                    android:layout_marginTop="2dp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ad_call_to_action"
            style="@style/Widget.Ad.Cta"
            android:layout_marginTop="@dimen/ad_gap" />
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
