<?xml version="1.0" encoding="utf-8"?>
<!-- Figma Collap1, dạng mở rộng: media 16:9 có nút thu gọn / info B / CTA rộng hết. Dải khi thu gọn: ad_tpl_tiny1.
     ad_collapse bị ẩn; màn hình nào thu gọn thẻ thì hiện nút này và xử lý click. -->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ad_card"
    android:padding="@dimen/ad_card_padding">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.namstd.androidskillhub.core.ads.template.AdMediaFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:adCornerRadius="@dimen/ad_media_radius"
                app:adRatio="16:9">

                <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
                    android:id="@+id/ad_media"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.namstd.androidskillhub.core.ads.template.AdMediaFrame>

            <include
                layout="@layout/ad_tpl_part_info_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ad_gap" />

            <TextView
                android:id="@+id/ad_call_to_action"
                style="@style/Widget.Ad.Cta"
                android:layout_marginTop="@dimen/ad_gap" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ad_collapse"
            style="@style/Widget.Ad.Action"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:src="@drawable/ic_ad_collapse" />
    </FrameLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
