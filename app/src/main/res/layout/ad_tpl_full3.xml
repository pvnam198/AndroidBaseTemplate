<?xml version="1.0" encoding="utf-8"?>
<!-- Figma Full3 (toàn màn hình, nền sáng): nhãn Ad + nút đóng ở trên / media 16:9 căn giữa / thông tin / CTA rộng hết.
     ad_close bị ẩn; màn hình hiển thị quảng cáo quyết định khi nào nút hiện ra và nút làm gì. -->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ad_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="@dimen/ad_card_padding"
            android:paddingEnd="@dimen/ad_card_padding">

            <TextView
                style="@style/Widget.Ad.Badge"
                android:layout_gravity="start|center_vertical" />

            <ImageView
                android:id="@+id/ad_close"
                style="@style/Widget.Ad.Action"
                android:layout_gravity="end|center_vertical"
                android:src="@drawable/ic_ad_close" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.namstd.androidskillhub.core.ads.template.AdMediaFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:adRatio="16:9">

                <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
                    android:id="@+id/ad_media"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.namstd.androidskillhub.core.ads.template.AdMediaFrame>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <include layout="@layout/ad_tpl_part_info_plain" />

            <TextView
                android:id="@+id/ad_call_to_action"
                style="@style/Widget.Ad.Cta"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
