<?xml version="1.0" encoding="utf-8"?>
<!-- Hàng info E: icon | Tiêu đề / nội dung / [Ad] sao (không hiện giá). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ad_icon"
        style="@style/Widget.Ad.Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ad_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ad_headline"
            style="@style/Widget.Ad.Title"
            android:layout_width="match_parent"
            android:layout_weight="0" />

        <TextView
            android:id="@+id/ad_body"
            style="@style/Widget.Ad.Body"
            android:layout_marginTop="2dp"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView style="@style/Widget.Ad.Badge" />

            <RatingBar
                android:id="@+id/ad_stars"
                style="@style/Widget.Ad.Stars" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
