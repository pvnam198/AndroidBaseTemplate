<?xml version="1.0" encoding="utf-8"?>
<!-- Figma Tiny1 (cũng là dải thu gọn của Collap1 / Collap3): icon | [Ad] tiêu đề / nội dung | CTA thu gọn. -->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ad_card"
    android:paddingStart="@dimen/ad_card_padding"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/ad_card_padding"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ad_icon"
            style="@style/Widget.Ad.Icon"
            android:layout_width="@dimen/ad_icon_s"
            android:layout_height="@dimen/ad_icon_s" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ad_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <include layout="@layout/ad_tpl_part_title_row" />

            <TextView
                android:id="@+id/ad_body"
                style="@style/Widget.Ad.Body"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ad_call_to_action"
            style="@style/Widget.Ad.Cta.Small"
            android:layout_marginStart="@dimen/ad_gap"
            android:minWidth="72dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
